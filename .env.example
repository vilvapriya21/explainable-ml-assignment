
# RANDOM_SEED default: 42
RANDOM_SEED=42
# FN_COST default: 5.0
FN_COST=5.0
# FP_COST default: 1.0
FP_COST=1.0
# ARTIFACTS_DIR default: artifacts
ARTIFACTS_DIR=artifacts
# MODEL_PATH default: artifacts/model.joblib
MODEL_PATH=artifacts/model.joblib
# METRICS_PATH default: artifacts/metrics.json
METRICS_PATH=artifacts/metrics.json
# SHAP_SUMMARY_PATH default: artifacts/shap_summary.json
SHAP_SUMMARY_PATH=artifacts/shap_summary.json
# LIME_SUMMARY_PATH default: artifacts/lime_summary.json
LIME_SUMMARY_PATH=artifacts/lime_summary.json
# MODEL_REVIEW_PATH default: artifacts/model_review.md
MODEL_REVIEW_PATH=artifacts/model_review.md
# LABEL_MAPPING_PATH default: artifacts/label_mapping.json
LABEL_MAPPING_PATH=artifacts/label_mapping.json
# LOG_LEVEL default: INFO
LOG_LEVEL=INFO
# AGENT_MAX_ITER default: 5
AGENT_MAX_ITER=5
# AGENT_TIMEOUT_SECONDS default: 300
AGENT_TIMEOUT_SECONDS=300
# API_TITLE default: Explainable ML Model Evaluation API
API_TITLE="Explainable ML Model Evaluation API"
# API_VERSION default: 1.0.0
API_VERSION=1.0.0
# Optional provider configuration for the CrewAI workflow.
# Keep real API keys only in a local .env file; never commit them.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
